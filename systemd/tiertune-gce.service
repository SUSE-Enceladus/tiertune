[Unit]
Description=Configure GCE instance
DefaultDependencies=no
ConditionFirstBoot=yes
After=local-fs.target network-online.target
Wants=network-online.target
ConditionPathExists=/usr/share/tiertune/tiertune-gce.yml

[Service]
Type=oneshot
Environment="TIERTUNE_LOGLEVEL=DEBUG"
ExecStart=/usr/bin/tiertune-gce
RemainAfterExit=yes

[Install]
WantedBy=sysinit.target
